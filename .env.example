# Server-only secrets (set as Vercel env vars; never commit real values)
AGENT_FC_KEYS=ed25519:...,ed25519:...      # function-call keys of artist.atelier-one.testnet (agent_* methods only)
COLLECTOR_KEY=ed25519:...                  # demo collector account key (testnet)
DEMO_OWNER_FC_KEY=ed25519:...              # demo owner function-call key (set_kill_switch / update_rules only)
JOB_SECRET=random-hex                      # HMAC for job tokens between generate → mint → list
PINATA_JWT=...                             # IPFS pinning
BLOB_READ_WRITE_TOKEN=...                  # Vercel Blob (public ledger index)
NEAR_AI_API_KEY=                           # optional: NEAR AI Cloud key; empty = local generative painter fallback
# NEAR_AI_TEXT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# NEAR_AI_IMAGE_MODEL=black-forest-labs/FLUX.2-klein-4B
# NEAR_AI_IMAGE=off                        # use the SVG painter even when the key is set
